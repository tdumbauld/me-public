# Installed as /etc/me_public.env, mode 600 root:deploy. NEVER COMMITTED.
# systemd reads it as root before dropping to User=deploy, which is why 600
# works. Fill the three beehiiv values by hand on the box.

# From beehiiv: Settings -> Integrations -> API. Publication id starts "pub_".
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Only once a paid tier exists. LEAVING THIS UNSET IS SAFE AND IS THE POINT:
# configured_levels() fails closed, so a route requiring Premium denies and
# says the level is unavailable. Setting it to a wrong id would be worse.
# BEEHIIV_PREMIUM_TIER_ID=

# Signs sessions AND magic links. Rotating it invalidates every one of both at
# once, which is the revocation story. Generated on the box; never reuse a key
# from anywhere else.
ME_PUBLIC_SECRET=

# Where the site lives. site_url is baked into the magic links, so it must be
# the public https origin or every link points at the wrong host.
SITE_URL=https://tools.morningexecution.com
SUBSCRIBE_URL=https://www.morningexecution.com/
UPGRADE_URL=https://www.morningexecution.com/upgrade

# Optional. Defaults in core/config.py: 1200 / 120 / 86400 seconds, 24h
# sessions, 15 minute links, cookie name me_access, secure cookies on.
# ACCESS_HIT_TTL=1200
# ACCESS_MISS_TTL=120
# ACCESS_STALE_TTL=86400
# SESSION_HOURS=24
# MAGIC_LINK_MINUTES=15
# COOKIE_SECURE=1
